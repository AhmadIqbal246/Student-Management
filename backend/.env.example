# ---- Server ----
NODE_ENV=development
PORT=5000
# Allowed frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=student_management

# ---- Auth ----
# Used to sign access tokens. Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# Access token lifetime (short: limits damage if one is stolen)
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime (how long a user stays logged in)
REFRESH_TOKEN_TTL_DAYS=7
# A rotated refresh token reused within this many seconds counts as two tabs refreshing
# at once, not theft
REFRESH_REUSE_GRACE_SECONDS=5
BCRYPT_SALT_ROUNDS=10
